# =============================================================================
# MONDINO CLUB — FARMACIA Y PERFUMERÍA MONDINO
# Variables de Entorno para Desarrollo Local y Producción (Vercel + Supabase)
# =============================================================================

# URL del proyecto de Supabase (expuesta al frontend Vite y usada por el backend)
VITE_SUPABASE_URL="https://tu-proyecto.supabase.co"
SUPABASE_URL="https://tu-proyecto.supabase.co"

# Clave pública anónima (anon key) de Supabase.
# Segura para el navegador siempre que Row Level Security (RLS) esté activo
# mediante las migraciones en /supabase/migrations/.
VITE_SUPABASE_ANON_KEY="tu-supabase-anon-key"
SUPABASE_ANON_KEY="tu-supabase-anon-key"

# (Opcional — SOLO BACKEND / VERCEL SERVERLESS)
# No se requiere para la operación normal ya que todas las funciones RPC atómicas
# validan auth.uid() y roles directamente en PostgreSQL con el JWT del usuario.
SUPABASE_SERVICE_ROLE_KEY=""

# (Opcional — Entorno AI Studio)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="http://localhost:3000"
